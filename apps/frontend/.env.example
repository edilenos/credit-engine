# Base da API. Sem barra no final — o cliente HTTP concatena o caminho.
#
# A porta e' 8081, nao a 8080 padrao do Spring Boot.
#
# Copie este arquivo para .env.local (gitignorado) antes de rodar `pnpm dev`.
# Nao existe valor padrao no codigo de proposito: um fallback faria a aplicacao
# funcionar so na maquina de quem escreveu.
NEXT_PUBLIC_API_URL=http://localhost:8081
