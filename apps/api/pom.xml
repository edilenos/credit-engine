<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>br.com.srm</groupId>
	<artifactId>credit-engine</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!--
			Resilience4j nao e' gerenciado pelo BOM do Spring Boot, entao a versao
			e' explicita. ATENCAO ao artefato: existem resilience4j-spring-boot3 e
			-spring-boot4 na mesma versao 2.4.0, e o errado resolve, baixa e
			compila — falha so na autoconfiguracao, em runtime.
		-->
		<resilience4j.version>2.4.0</resilience4j.version>
		<!--
			BigDecimal.pow() so aceita expoente int, e quatro das seis convencoes
			de contagem produzem expoente fracionario — e' o caso normal, nao a
			excecao. Esta biblioteca faz potenciacao com expoente decimal em
			precisao arbitraria e deterministica.

			A alternativa seria Math.pow com double: erro relativo na casa de
			1e-16, numericamente irrelevante, mas indefensavel sob um criterio de
			avaliacao chamado "precisao decimal". Ver docs/backlog.md, PBI-21.
		-->
		<big-math.version>2.3.2</big-math.version>
		<!--
			springdoc-openapi: usar a linha 3.0.x, que e a do Spring Boot 4.
			A 2.8.x e a do Boot 3 e e o que a maioria do material disponivel vai
			sugerir; ela resolve e compila, e falha na autoconfiguracao — mesma
			armadilha do resilience4j acima.

			O 3.0.3 foi construido contra Boot 4.0.5 e aqui o parent e 4.1.0.
			Conferido por dependency:tree e por smoke test do /swagger-ui.html
			com o servidor no ar, nao por suposicao. Ver docs/backlog.md, R1/R9.
		-->
		<springdoc.version>3.0.3</springdoc.version>
		<spotless.version>3.8.0</spotless.version>
		<checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
		<checkstyle.version>10.21.4</checkstyle.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<!--
			O Actuator sozinho nao expoe /actuator/prometheus: o endpoint so
			nasce quando ha um MeterRegistry do Prometheus no classpath. Versao
			gerenciada pelo BOM do Spring Boot.

			Log estruturado NAO precisa de dependencia: o Boot 4 traz os
			formatos ecs, gelf e logstash embutidos. Adicionar
			logstash-logback-encoder, que e o reflexo vindo do Boot 2/3, seria
			dependencia morta.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-spring-boot4</artifactId>
			<version>${resilience4j.version}</version>
		</dependency>
		<!--
			As anotacoes do Resilience4j sao aspectos: sem AOP no classpath elas
			viram no-op silencioso. Nao vem transitivo do artefato acima.

			ATENCAO: no Boot 4 o starter chama-se spring-boot-starter-ASPECTJ.
			O spring-boot-starter-aop do Boot 3 nao existe mais no BOM.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aspectj</artifactId>
		</dependency>
		<dependency>
			<groupId>ch.obermuhlner</groupId>
			<artifactId>big-math</artifactId>
			<version>${big-math.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!--
				Spotless: HIGIENE, nao reformatacao.

				A escolha obvia seria googleJavaFormat, e ela foi medida antes de
				ser descartada: reescreveria 147 arquivos, 19 mil linhas, porque
				requebra todo javadoc em 100 colunas e reordena imports por outra
				convencao. Num projeto cujo historico de Git e' entregavel
				avaliado, isso enterraria a mudanca real em ruido e reescreveria
				o `git blame` de tudo — custo alto para ganho estetico.

				O que fica sao as regras que pegam problema de verdade e cuja
				correcao e' sempre segura: import nao usado, import com curinga,
				ordem de import, espaco em branco no fim da linha, arquivo sem
				quebra final. A ordem configurada e' a que o projeto ja seguia,
				nao uma nova.
			-->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless.version}</version>
				<configuration>
					<java>
						<removeUnusedImports/>
						<importOrder>
							<!--
								`\#` sao os imports estaticos, e vem PRIMEIRO: e' a
								ordem que o projeto ja usava em todos os testes.
								Deixa-los no fim, que e' o default de varias
								convencoes, moveria import em 36 arquivos para
								acomodar a ferramenta em vez do contrario.
							-->
							<order>\#,java,javax,org,</order>
						</importOrder>
						<trimTrailingWhitespace/>
						<endWithNewline/>
					</java>
					<!--
						Sem sortPom pelo mesmo motivo: ordenar as dependencias
						desgrudaria cada comentario da dependencia que ele explica,
						e sao esses comentarios que registram as armadilhas de
						versao (resilience4j-spring-boot4, springdoc 3.0.x).
					-->
				</configuration>
				<executions>
					<execution>
						<!--
							Ligado a `verify`, e nao a `compile`: e' a mesma fase que
							o hook de pre-push e o CI executam, entao local e
							pipeline aplicam exatamente as mesmas regras. Divergencia
							entre os dois e' como se aprende a ignorar o linter.
						-->
						<id>spotless-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!--
				Checkstyle: as regras que o Spotless nao cobre porque nao sao de
				formatacao — chave ausente em if de uma linha, igualdade de
				String com ==, catch vazio, classe utilitaria instanciavel.

				Configuracao propria em checkstyle.xml. Os pacotes padrao (sun,
				google) trazem dezenas de regras de estilo que brigariam com o
				codigo existente pelo mesmo motivo do googleJavaFormat.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>${checkstyle.plugin.version}</version>
				<dependencies>
					<dependency>
						<groupId>com.puppycrawl.tools</groupId>
						<artifactId>checkstyle</artifactId>
						<version>${checkstyle.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<configLocation>checkstyle.xml</configLocation>
					<includeTestSourceDirectory>true</includeTestSourceDirectory>
					<consoleOutput>true</consoleOutput>
					<failsOnError>true</failsOnError>
					<violationSeverity>warning</violationSeverity>
				</configuration>
				<executions>
					<execution>
						<id>checkstyle-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
