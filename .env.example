# Variaveis consumidas pelo docker-compose.yml.
# Copie para .env e preencha:
#
#     cp .env.example .env
#
# O .env e' ignorado pelo Git (ver .gitignore da raiz) e NUNCA deve ser
# versionado - este repositorio e' publico.

# Obrigatoria: sem ela o Compose recusa subir, de proposito.
DB_PASSWORD=troque_por_uma_senha_local

# Opcionais - os valores abaixo sao os defaults do docker-compose.yml.
DB_USERNAME=postgres
DB_NAME=credit-engine
DB_PORT=55432

# ---------------------------------------------------------------------------
# ATENCAO - duas fontes de credencial que precisam bater
#
# Este .env configura o CONTAINER do banco.
# A API, rodando no host via ./mvnw, le apps/api/application-local.yaml.
# Enquanto a API nao estiver containerizada (PBI-38), as duas senhas precisam
# ser a mesma, senao a aplicacao nao conecta no banco que o Compose subiu.
#
# Alternativa sem application-local.yaml: exportar DB_URL, DB_USERNAME e
# DB_PASSWORD no ambiente antes do ./mvnw - o import daquele arquivo e'
# 'optional:', entao a aplicacao sobe sem ele.
# ---------------------------------------------------------------------------
