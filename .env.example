# Variaveis consumidas pelo docker-compose.yml.
# Copie para .env e preencha:
#
#     cp .env.example .env
#
# O .env e' ignorado pelo Git (ver .gitignore da raiz) e NUNCA deve ser
# versionado - este repositorio e' publico.

# Obrigatoria: sem ela o Compose recusa subir, de proposito.
DB_PASSWORD=troque_por_uma_senha_local

# Opcionais - os valores abaixo sao os defaults do docker-compose.yml.
DB_USERNAME=postgres
DB_NAME=credit-engine
DB_PORT=55432
API_PORT=8081
FRONTEND_PORT=3000

# Origem do navegador que o CORS da API aceita. Precisa bater com o endereco
# pelo qual voce abre o frontend, nao com o nome do servico no Compose.
FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# ATENCAO - esta variavel e' de tempo de BUILD, nao de runtime
#
# NEXT_PUBLIC_* e' substituida dentro do bundle quando a imagem e' construida.
# Muda-la e dar `docker compose up` NAO tem efeito; e' preciso reconstruir:
#
#     docker compose up --build
#
# E o valor precisa ser alcancavel pelo NAVEGADOR, nao pelo container. Quem
# chama a API e' o browser do operador, entao http://api:8081 - que resolveria
# de container para container - daria erro de DNS na maquina dele.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8081

# Observabilidade da API. LOG_FORMATO aceita ecs, gelf ou logstash.
LOG_FORMATO=ecs
LOG_NIVEL=INFO

# ---------------------------------------------------------------------------
# DESENVOLVIMENTO FORA DO CONTAINER
#
# Rodando so o banco (`docker compose up -d db`) e a API pelo ./mvnw, a
# aplicacao le apps/api/application-local.yaml - e a senha de la precisa ser a
# mesma deste arquivo, senao nao conecta.
#
# Alternativa sem application-local.yaml: exportar DB_URL, DB_USERNAME e
# DB_PASSWORD no ambiente antes do ./mvnw. O import daquele arquivo e'
# 'optional:', entao a aplicacao sobe sem ele.
# ---------------------------------------------------------------------------
